# Database configuration (SQLite for local zero-config, or mysql://user:password@localhost:3306/plagiarism_detector)
DATABASE_URL="file:./dev.db"

# Prisma engine binaries local overrides (Optional Windows local paths if needed)
# PRISMA_QUERY_ENGINE_LIBRARY="./node_modules/@prisma/engines/query_engine-windows.dll.node"
# PRISMA_SCHEMA_ENGINE_BINARY="./node_modules/@prisma/engines/schema-engine-windows.exe"

# AI Inference Gateway API Keys (Optional - local vectorizers and AST parsers run automatically if empty)
HUGGINGFACE_API_KEY=""
OPENAI_API_KEY=""

# Application Secret
NEXTAUTH_SECRET="plagiarism-detector-dev-secret-key-32chars-token"
NEXTAUTH_URL="http://localhost:3000"
