datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String        @default("")
  role          String        @default("STUDENT")
  adminRole     String?
  tierCode      String        @default("FREE")
  accountStatus String        @default("ACTIVE")
  submissions   Submission[]
  createdAt     DateTime      @default(now())
}

model Submission {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  artifacts   Artifact[]
  jobs        ComparisonJob[]
  createdAt   DateTime        @default(now())
}

model Artifact {
  id              String          @id @default(cuid())
  submissionId    String
  submission      Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type            String
  originalFileUrl String
  normalizedText  String?         @db.LongText
  language        String?
  embedding       String?         @db.LongText
  embeddingModel  String?
  createdAt       DateTime        @default(now())

  comparisonsAsA  ComparisonJob[] @relation("ArtifactA")
  comparisonsAsB  ComparisonJob[] @relation("ArtifactB")
}

model ComparisonJob {
  id              String          @id @default(cuid())
  submissionId    String
  submission      Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  artifactAId     String
  artifactA       Artifact        @relation("ArtifactA", fields: [artifactAId], references: [id], onDelete: Cascade)
  artifactBId     String
  artifactB       Artifact        @relation("ArtifactB", fields: [artifactBId], references: [id], onDelete: Cascade)
  status          String          @default("PENDING")
  similarityScore Float?
  rawCosine       Float?
  reportJson      String?         @db.LongText
  errorMessage    String?
  createdAt       DateTime        @default(now())
  completedAt     DateTime?
}

model AdminSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.LongText
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model AIProviderConfig {
  id             String   @id @default(cuid())
  provider       String
  name           String
  apiKeyMasked   String?
  endpointUrl    String?
  isEnabled      Boolean  @default(false)
  isFallback     Boolean  @default(false)
  modelId        String
  maxTokens      Int      @default(4096)
  temperature    Float    @default(0.1)
  timeoutMs      Int      @default(15000)
  lastLatencyMs  Int?
  status         String   @default("DISCONNECTED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MultimodalScoringFormula {
  id                   String   @id @default(cuid())
  textWeight           Float    @default(0.40)
  codeWeight           Float    @default(0.35)
  diagramWeight        Float    @default(0.25)
  similarityThreshold  Float    @default(75.0)
  strictMode           Boolean  @default(true)
  updatedBy            String?
  updatedAt            DateTime @updatedAt
}

model CmsNode {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  contentJson String   @db.LongText
  isPublished Boolean  @default(true)
  version     Int      @default(1)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model PaymentGatewayConfig {
  id                  String   @id @default(cuid())
  gateway             String
  name                String
  publicKey           String?
  secretKeyMasked     String?
  webhookSecretMasked String?
  isLiveMode          Boolean  @default(false)
  isEnabled           Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model SubscriptionTier {
  id                      String   @id @default(cuid())
  code                    String   @unique
  name                    String
  priceMonthlyCents       Int      @default(0)
  monthlyScanAllowance    Int      @default(50)
  rateLimitPerMinute      Int      @default(10)
  overagePricePerScanCents Int     @default(0)
  featuresJson            String   @db.LongText
  isActive                Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

model TransactionLedger {
  id              String   @id @default(cuid())
  invoiceId       String   @unique
  userId          String
  userEmailMasked String?
  gateway         String
  amountCents     Int
  currency        String   @default("USD")
  status          String
  createdAt       DateTime @default(now())
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  actorRole  String
  action     String
  target     String
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model TelemetryEvent {
  id         String   @id @default(cuid())
  taskUuid   String   @unique
  modality   String
  durationMs Int
  tokenUsage Int?
  statusCode Int      @default(200)
  createdAt  DateTime @default(now())
}
